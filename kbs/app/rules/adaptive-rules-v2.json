      "description": "Tỷ lệ giao thất bại đã xác minh do buyer theo phone",
      "max_points": 45,
      "enabled": true,
      "params": {
        "window_days": 180,
        "alpha": 2,
        "prior": 0.1,
        "tiers": [
          [
            0.25,
            15
          ],
          [
            0.5,
            30
          ],
          [
            0.75,
            45
          ]
        ]
      },
      "authority": "team_demo_assumption_not_verified_platform_policy"
    },
    {
      "rule_id": "R2",
      "description": "Tỷ lệ giao thất bại đã xác minh do buyer theo cụm địa chỉ",
      "max_points": 30,
      "enabled": true,
      "params": {
        "window_days": 180,
        "alpha": 2,
        "prior": 0.1,
        "tiers": [
          [
            0.25,
            10
          ],
          [
            0.5,
            20
          ],
          [
            0.75,
            30
          ]
        ]
