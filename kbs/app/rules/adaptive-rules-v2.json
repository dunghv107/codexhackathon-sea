      "authority": "team_demo_assumption_not_verified_platform_policy"
    },
    {
      "rule_id": "R3",
      "description": "Số lần giao thất bại đã xác minh do buyer theo phone",
      "max_points": 40,
      "enabled": true,
      "params": {
        "window_days": 90,
        "minimum": 3
      },
      "authority": "team_demo_assumption_not_verified_platform_policy"
    },
    {
      "rule_id": "R4",
      "description": "Số shop khác nhau qua phone hoặc device; không tự phạt giỏ nhiều shop",
      "max_points": 20,
      "enabled": true,
      "params": {
        "window_hours": 24,
        "minimum_shops": 3,
        "minimum_distinct_checkouts": 3
      },
      "authority": "team_demo_assumption_not_verified_platform_policy"
    },
    {
      "rule_id": "R5",
      "description": "Số checkout riêng biệt qua phone hoặc cụm địa chỉ",
      "max_points": 25,
      "enabled": true,
      "params": {
        "window_hours": 1,
        "minimum_checkouts": 3,
        "requires": "R3 OR R6"
      },
      "authority": "team_demo_assumption_not_verified_platform_policy"
    },
    {
      "rule_id": "R6",
      "description": "Nhiều buyer dùng cụm địa chỉ có lịch sử thất bại do buyer",
      "max_points": 20,
      "enabled": true,
      "params": {
        "window_days": 90,
        "minimum_buyers": 3,
        "minimum_resolved_checkouts": 3,
        "buyer_failure_rate_strictly_above": 0.25
