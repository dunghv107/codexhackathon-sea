# Copy to .env; generate private random hex values (docs/CONTAINERS.md).
# Hex passwords avoid URI escaping in the migration connection string.
DB_PASSWORD=
DB_ADMIN_PASSWORD=
JWT_SECRET=
DB_USER=app
DB_NAME=ai_fraud_detection
COMPOSE_PROJECT_NAME=codexhackathon
FRONTEND_PORT=8080
# runtime = no shell; debug = shell with identical application artifacts.
RUNTIME_VARIANT=runtime
IMAGE_TAG=local
COOKIE_SECURE=false
RATE_LIMIT_REQUESTS_PER_MIN=60
