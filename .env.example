# Copy to .env; generate private random hex values (docs/CONTAINERS.md).
# Hex passwords avoid URI escaping in the migration connection string.
DB_PASSWORD=
DB_ADMIN_PASSWORD=
JWT_SECRET=
# Generate once (at least 32 random bytes); keep stable to preserve phone history.
PHONE_HMAC_SECRET=
DEMO_MODE=true
DB_USER=app
DB_NAME=ai_fraud_detection
COMPOSE_PROJECT_NAME=codexhackathon
FRONTEND_PORT=18081
# On dfm-ia, set 192.168.2.14 so the separate reverse proxy can reach frontend.
FRONTEND_BIND_IP=127.0.0.1
# runtime = no shell; debug = shell with identical application artifacts.
RUNTIME_VARIANT=runtime
IMAGE_TAG=local
COOKIE_SECURE=false
RATE_LIMIT_REQUESTS_PER_MIN=60
# Optional KBS explanations; keep the API key only in private .env files.
KBS_EXPLAIN_ENABLED=false
KBS_EXPLAIN_MODEL=
KBS_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
